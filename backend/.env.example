# Copy to backend/.env and fill in real values - never commit .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=pakkatrip
DB_USER=pakkatrip
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Razorpay: Dashboard -> Account & Settings -> API keys (use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Dashboard -> Webhooks: the secret you choose there (needed only when the webhook URL is public)
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_HOLD_MINUTES=15
# RazorpayX payouts to operators: the RazorpayX account number money is paid from (RazorpayX Dashboard -> My Account)
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_PAYOUT_MODE=IMPS
# Encrypts operator bank account numbers and PAN. Set once before real data; never change it afterwards.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# MSG91 (SMS one-time codes): control.msg91.com -> Authkey, and the ID of a DLT-approved OTP template.
# Leave empty in development: the code is then shown on screen instead of being texted.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
