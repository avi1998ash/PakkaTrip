# Copy to backend/.env and fill in real values - never commit .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Public site address. Production: SITE_URL=https://pakkatrip.online and
# DJANGO_ALLOWED_HOSTS=pakkatrip.online,www.pakkatrip.online (change both when moving domains)
SITE_URL=http://localhost:5173
# Business details for the Contact / Terms / Privacy / Refund pages (Razorpay checks these before going live)
SITE_BRAND=PakkaTrip
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=Monday to Saturday, 10 am to 7 pm IST
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
LEGAL_JURISDICTION_CITY=
DB_NAME=pakkatrip
DB_USER=pakkatrip
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Razorpay: Dashboard -> Account & Settings -> API keys (use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Dashboard -> Webhooks: the secret you choose there (needed only when the webhook URL is public)
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_HOLD_MINUTES=15
# RazorpayX payouts to operators: the RazorpayX account number money is paid from (RazorpayX Dashboard -> My Account)
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_PAYOUT_MODE=IMPS
# Encrypts operator bank account numbers and PAN. Set once before real data; never change it afterwards.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# MSG91 (SMS one-time codes): control.msg91.com -> Authkey, and the ID of a DLT-approved OTP template.
# Leave empty in development: the code is then shown on screen instead of being texted.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
GRIEVANCE_OFFICER_PHONE=
# Email one-time codes (Gmail SMTP): EMAIL_HOST_USER = the Gmail address; EMAIL_HOST_PASSWORD = a 16-character
# App Password (Google Account -> Security -> 2-Step Verification -> App passwords), never the account password.
# Leave EMAIL_HOST_USER empty in development: emails are then printed to the server log and the code shown on screen.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
