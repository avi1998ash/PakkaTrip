    { "src": "/icons/partner-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/partner-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/partner-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
